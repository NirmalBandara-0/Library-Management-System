<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.MainDashboardController">

    <children>

        <AnchorPane prefHeight="70.0" prefWidth="900.0"
                    style="-fx-background-color: #D9CECC;">
            <children>
                <Label layoutX="252.0" layoutY="21.0"
                       text="Library Management System">
                    <font>
                        <Font name="Arial Bold" size="24.0"/>
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <AnchorPane layoutY="70.0" prefHeight="530.0"
                    prefWidth="180.0"
                    style="-fx-background-color: #D9CECC;">
            <children>
                <Label layoutX="55.0" layoutY="20.0" text="MENU">
                    <font>
                        <Font name="Arial Bold" size="20.0"/>
                    </font>
                </Label>

                <Button layoutX="15.0" layoutY="70.0"
                        prefHeight="40.0" prefWidth="150.0"
                        text="Dashboard"/>

                <Button fx:id="btnbooks" layoutX="15.0" layoutY="120.0"
                        onAction="#booksOnAction"
                        prefHeight="40.0" prefWidth="150.0"
                        text="Books"/>

                <Button fx:id="btnmembers" layoutX="15.0" layoutY="170.0"
                        onAction="#membersOnAction"
                        prefHeight="40.0" prefWidth="150.0"
                        text="Members"/>

                <Button fx:id="btnBorrowedBooks" layoutX="15.0" layoutY="220.0"
                        onAction="#borrowedBooksOnAction"
                        prefHeight="40.0" prefWidth="150.0"
                        text="Borrowed Books"/>

                <Button fx:id="btnReturnBook" layoutX="17.0" layoutY="272.0"
                        onAction="#returnBookOnAction"
                        prefHeight="40.0" prefWidth="144.0"
                        text="Return Book"/>

                <Button fx:id="btnBorrowingHistory" layoutX="18.0" layoutY="324.0"
                        onAction="#borrowingHistoryOnAction"
                        prefHeight="40.0" prefWidth="144.0"
                        text="Borrowing History"/>

                <Button fx:id="btnlogout" layoutX="15.0" layoutY="450.0"
                        onAction="#logoutOnAction"
                        prefHeight="40.0" prefWidth="150.0"
                        text="Logout"/>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="220.0" layoutY="130.0"
                    prefHeight="130.0" prefWidth="200.0"
                    style="-fx-background-color: #F2EDED;">
            <children>
                <Label layoutX="20.0" layoutY="20.0" text="Total Books">
                    <font><Font name="Arial Bold" size="18.0"/></font>
                </Label>
                <Label fx:id="lblTotalBooks" layoutX="20.0" layoutY="60.0"
                       text="0">
                    <font><Font name="Arial Bold" size="32.0"/></font>
                </Label>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="550.0" layoutY="130.0"
                    prefHeight="130.0" prefWidth="200.0"
                    style="-fx-background-color: #F2EDED;">
            <children>
                <Label layoutX="20.0" layoutY="20.0" text="Total Members">
                    <font><Font name="Arial Bold" size="18.0"/></font>
                </Label>
                <Label fx:id="lblTotalMembers" layoutX="20.0" layoutY="59.0"
                       text="0">
                    <font><Font name="Arial Bold" size="32.0"/></font>
                </Label>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="220.0" layoutY="335.0"
                    prefHeight="130.0" prefWidth="200.0"
                    style="-fx-background-color: #F2EDED;">
            <children>
                <Label layoutX="10.0" layoutY="14.0"
                       text="Currently Borrowed">
                    <font><Font name="Arial Bold" size="18.0"/></font>
                </Label>
                <Label layoutX="10.0" layoutY="35.0" text="Books">
                    <font><Font name="Arial Bold" size="18.0"/></font>
                </Label>
                <Label fx:id="lblCurrentlyBorrowed" layoutX="20.0" layoutY="70.0"
                       text="0">
                    <font><Font name="Arial Bold" size="32.0"/></font>
                </Label>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="550.0" layoutY="342.0"
                    prefHeight="130.0" prefWidth="200.0"
                    style="-fx-background-color: #F2EDED;">
            <children>
                <Label layoutX="20.0" layoutY="20.0" text="Overdue Books">
                    <font><Font name="Arial Bold" size="18.0"/></font>
                </Label>
                <Label fx:id="lblOverdueBooks" layoutX="18.0" layoutY="61.0"
                       text="0">
                    <font><Font name="Arial Bold" size="32.0"/></font>
                </Label>
            </children>
        </AnchorPane>

    </children>
</AnchorPane>
