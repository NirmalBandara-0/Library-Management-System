<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.BorrowingHistoryController"
            style="-fx-background-color: #F4F6F8;">

    <children>

        <AnchorPane prefHeight="75.0" prefWidth="900.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0"
                    style="-fx-background-color: #D9CECC;">
            <children>
                <Label layoutX="30.0" layoutY="20.0"
                       text="Library Management System - Borrowing History">
                    <font>
                        <Font name="Arial Bold" size="23.0"/>
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <Label layoutX="30.0" layoutY="100.0"
               text="All Borrowing Records">
            <font>
                <Font name="Arial Bold" size="20.0"/>
            </font>
        </Label>

        <TableView fx:id="tblBorrowingHistory"
                   layoutX="25.0"
                   layoutY="145.0"
                   prefWidth="850.0"
                   prefHeight="360.0"
                   AnchorPane.leftAnchor="25.0"
                   AnchorPane.rightAnchor="25.0">
            <columns>
                <TableColumn fx:id="colMemberId"
                             text="Member ID"
                             prefWidth="110.0"/>

                <TableColumn fx:id="colBookTitle"
                             text="Book Title"
                             prefWidth="200.0"/>

                <TableColumn fx:id="colIssueDate"
                             text="Issue Date"
                             prefWidth="130.0"/>

                <TableColumn fx:id="colDueDate"
                             text="Due Date"
                             prefWidth="130.0"/>

                <TableColumn fx:id="colReturnDate"
                             text="Return Date"
                             prefWidth="130.0"/>

                <TableColumn fx:id="colStatus"
                             text="Status"
                             prefWidth="145.0"/>
            </columns>
        </TableView>

        <Button layoutX="25.0"
                layoutY="535.0"
                prefWidth="180.0"
                prefHeight="40.0"
                text="Back to Dashboard"
                onAction="#backToDashboardOnAction"
                style="-fx-background-color: #D9CECC;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;"/>

    </children>
</AnchorPane>
